// schema.prisma
datasource db {
  provider = "mysql"  // Change to your database type: mysql, sqlite, etc.
  url      = env("DATABASE_URL") // Use environment variable for database connection string
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int    @id @default(autoincrement())
  username String
  email    String @unique
  password String
}